TARGET_IP=
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
# LATENCY_THRESHOLD: single value (berlaku untuk semua host) atau comma-separated per host sesuai urutan TARGET_IP
# Contoh: LATENCY_THRESHOLD=150 (semua host) atau LATENCY_THRESHOLD=150,200 (host1=150ms, host2=200ms)
LATENCY_THRESHOLD=150
PING_INTERVAL=30000
FAILURE_THRESHOLD=3
DELAY_BETWEEN_HOSTS=1000
